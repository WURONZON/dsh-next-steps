{
  "name": "@zongcn/dsh-next-steps",
  "version": "0.1.3",
  "description": "Suggests up to three prompts to send next after each finished turn, right above the composer.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "prompt",
    "suggestions",
    "composer",
    "ui"
  ],
  "homepage": "https://github.com/WURONZON/dsh-next-steps#readme",
  "bugs": {
    "url": "https://github.com/WURONZON/dsh-next-steps/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WURONZON/dsh-next-steps.git"
  },
  "author": "0xunknownz (https://github.com/WURONZON)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "test": "node scripts/selftest.mjs && node scripts/verify-dock.mjs",
    "selftest": "node scripts/selftest.mjs",
    "verify:dock": "node scripts/verify-dock.mjs",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets/readme/*.svg",
    "scripts/selftest.mjs",
    "scripts/verify-dock.mjs",
    "scripts/verify-ui.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
